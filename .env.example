# 复制为 .env 或在终端中设置同名环境变量。不要提交真实密码。
LEANTPM_DB_URL=jdbc:mysql://127.0.0.1:3306/leantpm?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
LEANTPM_DB_USERNAME=root
LEANTPM_DB_PASSWORD=change-me
LEANTPM_JWT_SECRET=replace-with-at-least-32-random-characters
LEANTPM_BOOTSTRAP_ADMIN_PASSWORD=replace-on-first-start
LEANTPM_UPLOAD_DIR=./var/uploads
VITE_BACKEND_URL=http://127.0.0.1:8080
