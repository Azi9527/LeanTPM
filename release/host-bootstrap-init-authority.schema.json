{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leantpm.example/schemas/host-bootstrap-init-authority.schema.json",
  "title": "LeanTPM externally provisioned HostBootstrap initialization authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorityId",
    "purpose",
    "status",
    "environmentId",
    "hostId",
    "notBeforeUtc",
    "notAfterUtc",
    "allowedActions",
    "initializerScriptSha256",
    "cmsEkuOid",
    "revocationMode",
    "planMaxValidityMinutes",
    "requesterSigners",
    "approverSigners",
    "executorSigners",
    "receiptSigners",
    "minimumApprovals",
    "requireDistinctIdentity",
    "requireDistinctCertificate",
    "initPlanSchemaSha256",
    "initReceiptSchemaSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "authorityId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "purpose": { "const": "HOST_BOOTSTRAP_INITIALIZATION" },
    "status": { "const": "ACTIVE" },
    "environmentId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "hostId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "notBeforeUtc": { "type": "string", "format": "date-time" },
    "notAfterUtc": { "type": "string", "format": "date-time" },
    "allowedActions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "INITIALIZE_HOST_BOOTSTRAP",
          "ADOPT_EXTERNAL_CADDY",
          "RECOVER_HOST_BOOTSTRAP"
        ]
      }
    },
    "initializerScriptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "cmsEkuOid": { "const": "1.3.6.1.5.5.7.3.3" },
    "revocationMode": { "const": "ONLINE_FAIL_CLOSED_ENTIRE_CHAIN" },
    "planMaxValidityMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
    "requesterSigners": { "$ref": "#/$defs/signers" },
    "approverSigners": { "$ref": "#/$defs/signers" },
    "executorSigners": { "$ref": "#/$defs/certificates" },
    "receiptSigners": { "$ref": "#/$defs/certificates" },
    "minimumApprovals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requester", "approver"],
      "properties": {
        "requester": { "const": 1 },
        "approver": { "const": 1 }
      }
    },
    "requireDistinctIdentity": { "const": true },
    "requireDistinctCertificate": { "const": true },
    "initPlanSchemaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "initReceiptSchemaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "signers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity", "certificateThumbprint", "certificateSha256"],
        "properties": {
          "identity": { "type": "string", "minLength": 3, "maxLength": 256 },
          "certificateThumbprint": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{40,128}$"
          },
          "certificateSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "certificates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["certificateThumbprint", "certificateSha256"],
        "properties": {
          "certificateThumbprint": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{40,128}$"
          },
          "certificateSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
