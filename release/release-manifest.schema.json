{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leantpm.example/schemas/release-manifest-v1.json",
  "title": "LeanTPM release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "releaseTier",
    "productVersion",
    "createdAtUtc",
    "source",
    "components",
    "compatibility",
    "artifacts",
    "signing",
    "rollback"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseId": { "type": "string", "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$))(?!.*\\.$)[a-z0-9][a-z0-9._-]{2,127}$" },
    "releaseTier": { "enum": ["TEST", "STAGING", "PRODUCTION"] },
    "productVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "createdAtUtc": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty", "treeSha256"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "dirty": { "const": false },
        "treeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sourceDateEpoch": { "type": "integer", "minimum": 0 }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "web", "app", "database"],
      "properties": {
        "backend": { "$ref": "#/$defs/productComponent" },
        "web": { "$ref": "#/$defs/productComponent" },
        "app": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "versionCode", "minimumSupportedVersionCode"],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
            },
            "versionCode": { "type": "integer", "minimum": 1 },
            "minimumSupportedVersionCode": { "type": "integer", "minimum": 1 },
            "includedInRelease": { "type": "boolean" }
          }
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine", "migrationTool", "schemaFrom", "schemaTo", "phase", "backwardCompatible", "requiresDowntime"],
          "properties": {
            "engine": { "const": "mysql" },
            "migrationTool": { "const": "flyway" },
            "schemaFrom": { "type": "integer", "minimum": 0 },
            "schemaTo": { "type": "integer", "minimum": 1 },
            "phase": { "enum": ["NONE", "EXPAND", "MIGRATE", "CONTRACT"] },
            "backwardCompatible": { "type": "boolean" },
            "requiresDowntime": { "type": "boolean" }
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrixPath", "unknownCombinationPolicy"],
      "properties": {
        "matrixPath": { "$ref": "#/$defs/packagePath" },
        "unknownCombinationPolicy": { "const": "BLOCKED" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "path", "size", "sha256"],
        "properties": {
          "component": { "enum": ["backend", "web", "app", "database", "config", "operations"] },
          "path": { "$ref": "#/$defs/packagePath" },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "mediaType": { "type": "string", "minLength": 1 }
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "required", "signaturePath", "certificateThumbprint"],
      "properties": {
        "algorithm": { "const": "CMS-SHA256" },
        "required": { "type": "boolean" },
        "signaturePath": { "type": ["string", "null"] },
        "certificateThumbprint": { "type": ["string", "null"], "pattern": "^[0-9A-Fa-f]{40,128}$" }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "previousReleaseRequired", "databaseRestoreRequired"],
      "properties": {
        "class": { "enum": ["APPLICATION_ONLY", "FORWARD_COMPATIBLE_SCHEMA", "RECOVERY_REQUIRED"] },
        "previousReleaseRequired": { "type": "boolean" },
        "databaseRestoreRequired": { "type": "boolean" },
        "instructions": { "type": "string" }
      }
    }
  },
  "$defs": {
    "productComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "type": "string" }
      }
    },
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
    }
  }
}
