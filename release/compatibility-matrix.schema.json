{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leantpm.example/schemas/compatibility-matrix-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "productVersion", "databaseSchemaVersion", "combinations", "unknownCombinationPolicy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "productVersion": { "type": "string" },
    "databaseSchemaVersion": { "type": "integer", "minimum": 1 },
    "combinations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["backend", "web", "appVersionCodeRange", "databaseSchema", "status", "notes"],
        "properties": {
          "backend": { "type": "string" },
          "web": { "type": "string" },
          "appVersionCodeRange": {
            "type": "object",
            "additionalProperties": false,
            "required": ["minimum", "maximum"],
            "properties": {
              "minimum": { "type": "integer", "minimum": 1 },
              "maximum": { "type": "integer", "minimum": 1 }
            }
          },
          "databaseSchema": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["SUPPORTED", "TRANSITIONAL", "FORCE_UPGRADE", "CANDIDATE_UNVERIFIED", "BLOCKED", "UNKNOWN"] },
          "notes": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unknownCombinationPolicy": { "const": "BLOCKED" }
  }
}
