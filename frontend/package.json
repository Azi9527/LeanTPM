{
  "name": "leantpm-frontend",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test \"tests/*.test.mjs\" \"tests/*.test.ts\"",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "preview": "vite preview",
    "mobile:sync": "npm run build && cap sync android",
    "android:doctor": "cap doctor android",
    "android:debug": "npm run mobile:sync && cd android && gradlew.bat assembleDebug",
    "android:release": "npm run mobile:sync && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.0.1",
    "@capacitor/barcode-scanner": "3.1.0",
    "@capacitor/camera": "8.2.1",
    "@capacitor/core": "8.4.2",
    "@capacitor/network": "8.0.1",
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.10.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.10.4",
    "pinia": "^3.0.3",
    "pinyin-pro": "3.28.2",
    "three": "^0.178.0",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@types/node": "^24.0.15",
    "@types/three": "^0.178.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "sass": "^1.89.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vue-tsc": "^3.0.3"
  }
}
