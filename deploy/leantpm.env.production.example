# Copy to a host-owned secret file with mode 0600. Never commit real values.
LEANTPM_DB_URL=jdbc:mysql://mysql.internal:3306/leantpm?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=true
LEANTPM_DB_USERNAME=leantpm_app
LEANTPM_DB_PASSWORD=replace-with-secret
LEANTPM_JWT_SECRET=replace-with-at-least-32-random-bytes
LEANTPM_REDIS_HOST=redis.internal
LEANTPM_REDIS_PORT=6379
LEANTPM_REDIS_DATABASE=0
LEANTPM_REDIS_PASSWORD=replace-with-secret
LEANTPM_UPLOAD_DIR=/var/lib/leantpm/uploads
LEANTPM_CORS_ALLOWED_ORIGINS=https://tpm.example.com
LEANTPM_OPENAPI_ENABLED=false
LEANTPM_REDIS_HEALTH_ENABLED=true
LEANTPM_IDEMPOTENCY_PROCESSING_SECONDS=300
LEANTPM_IDEMPOTENCY_COMPLETED_HOURS=24
SPRING_PROFILES_ACTIVE=prod
