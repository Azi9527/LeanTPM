<service>
  <id>LeanTPM.OpsControl</id>
  <name>LeanTPM Ops Control</name>
  <description>LeanTPM loopback-only operations control plane. It cannot execute deployment commands directly.</description>
  <executable>%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe</executable>
  <arguments>-NoProfile -NonInteractive -ExecutionPolicy AllSigned -File "@SERVICE_ROOT@\Start-LeanTpmOpsControl.ps1" -InstallRoot "@INSTALL_ROOT@" -DataRoot "@DATA_ROOT@" -JavaExecutable "@JAVA_EXECUTABLE@" -ExpectedJavaSha256 "@JAVA_SHA256@" -ExpectedJarSha256 "@OPS_JAR_SHA256@" -ExpectedConfigSha256 "@OPS_CONFIG_SHA256@"</arguments>
  <workingdirectory>@DATA_ROOT@\ops-control-plane</workingdirectory>
  <startmode>Manual</startmode>
  <stoptimeout>30sec</stoptimeout>
  <logpath>@DATA_ROOT@\ops-control-plane\logs</logpath>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <resetfailure>1 hour</resetfailure>
  <log mode="roll-by-size-time">
    <sizeThreshold>10485760</sizeThreshold>
    <pattern>yyyyMMdd</pattern>
    <autoRollAtTime>00:00:00</autoRollAtTime>
    <zipOlderThanNumDays>7</zipOlderThanNumDays>
  </log>
  <env name="SERVER_ADDRESS" value="127.0.0.1" />
  <env name="SERVER_PORT" value="18090" />
  <serviceaccount>
    <username>@OPS_SERVICE_ACCOUNT@</username>
  </serviceaccount>
</service>
