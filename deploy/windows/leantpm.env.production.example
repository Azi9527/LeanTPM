# This file contains non-secret values only. Secrets are DPAPI references in
# config\secret-references.json and protected blobs under dataRoot\secrets.
LEANTPM_SERVER_ADDRESS=127.0.0.1
LEANTPM_SERVER_PORT=18080
LEANTPM_DB_URL=jdbc:mysql://mysql.internal:3306/leantpm?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&sslMode=VERIFY_IDENTITY
LEANTPM_DB_USERNAME=leantpm_app
LEANTPM_UPLOAD_DIR=D:\LeanTPM\Runtime\data\uploads
LEANTPM_CORS_ALLOWED_ORIGINS=https://tpm.example.com
LEANTPM_OPENAPI_ENABLED=false
LEANTPM_FLYWAY_ENABLED=false
LEANTPM_FLYWAY_BASELINE_ON_MIGRATE=false
LEANTPM_RELEASE_VERSION=1.0.1
LEANTPM_DATABASE_SCHEMA_VERSION=50
